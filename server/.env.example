# Copy to .env on the VPS and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# Public hostname for the API, e.g. api.traverseminds.com (DNS A record -> this VPS)
API_DOMAIN=api.traverseminds.com

POSTGRES_PASSWORD=

# Used by the Cloudflare functions to store submissions (also set as SUBMISSIONS_API_TOKEN in Cloudflare)
INGEST_TOKEN=

# Used by you to list/export/update submissions. Must differ from INGEST_TOKEN.
ADMIN_TOKEN=
